# Application
APP_NAME=GitHub Intelligence Backend
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/github_intelligence

# Redis
REDIS_URL=redis://localhost:6379/0

# GitHub integration (placeholders only — no real values are committed)
GITHUB_API_URL=https://api.github.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Supabase Auth (third-party identity provider)
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
